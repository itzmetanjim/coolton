# --- AI provider keys ---------------------------------------------------------
# At least ONE provider key is required. coolton tries providers in the fallback
# order defined in agent/agent.py (_build_provider_order), using the FIRST keyed
# provider, then falling through on failure. You do NOT need to set all of them.
#
# Effective order (first key present wins):
#   JAMS_API_KEY  -> JAMS (Kimi / MiniMax / etc.)
#   HCAI_API_KEY  -> HCAI gateway
#   OPENROUTER_API_KEY / OPENROUTER_API_KEY_FALLBACK -> OpenRouter
#   ANTHROPIC_API_KEY -> Anthropic
#   OPENAI_API_KEY    -> OpenAI
#   GROQ_API_KEY      -> Groq
#   GOOGLE_API_KEY    -> Gemini
#   MISTRAL_API_KEY   -> Mistral
#   CEREBRAS_API_KEY  -> Cerebras
JAMS_API_KEY=YOUR_JAMS_API_KEY
HCAI_API_KEY=YOUR_HCAI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_API_KEY_FALLBACK=YOUR_OPENROUTER_API_KEY_FALLBACK
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY

# Optional, uncomment and set when running without the Slack CLI (python3 app.py).
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

# Required for OAuth (app_oauth.py). Set your app's OAuth credentials.
# SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
# SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
# SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
# SLACK_REDIRECT_URI=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/slack/oauth_redirect

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=YOUR_SLACK_API_URL

# Web search via Exa (free tier available)
# EXA_API_KEY=YOUR_EXA_API_KEY

# E2B sandbox for code execution
# E2B_API_KEY=YOUR_E2B_API_KEY

# AgentMail — email inbox API for AI agents (https://agentmail.to)
# Get a key at https://console.agentmail.to
# AGENTMAIL_API_KEY=am_us_YOUR_AGENTMAIL_KEY

# coolton's GitHub identity. The token is NEVER placed inside the E2B sandbox — the server
# injects it as an Authorization header at the E2B egress proxy for github.com / api.github.com
# (per-host request transforms), so the sandbox's gh/git are authenticated without the secret
# ever touching the sandbox filesystem or env.
# COOLTON_GH_USER=coolton-agent
# COOLTON_GH_TOKEN=ghp_YOUR_GITHUB_TOKEN

# BYOK encryption key (auto-generated if not set, saved to byok_key.bin)
# BYOK_ENCRYPTION_KEY=YOUR_CUSTOM_ENCRYPTION_KEY

# Optional: Cooldown User for MCP-enabled API calls
# COOLTON_USER_ID=U12345678
# SLACK_USER_TOKEN=xoxp-...

# coolton's own Slack bot user id (the @mention that resolves to coolton itself).
# Used so the agent recognises "<@COOLTON_BOT_ID>" as a self-reference, not a third party.
# COOLTON_BOT_ID=U0BEB7EAAG6

# --- Slack Bot Deployment (optional) -------------------------------------
# A Slack App Configuration Token (xoxe-...) used to create new Slack apps
# via the apps.manifest.create API. Generate at https://api.slack.com/apps
# under "Your App Configuration Tokens". Required for `create_slack_bot_tool`.
# SLACK_CONFIG_TOKEN=xoxe-...

# kevinton: the silent background agent that runs after every turn to capture
# reusable skills and open bugfix PRs. Enabled by default; set to "false" (or
# 0/no/off) to disable it entirely.
# KEVINTON_ENABLED=true

# --- Web UI (coolton.tanjim.org) ------------------------------------------
# coolton's own web UI, gated behind Hack Club Auth (https://auth.hackclub.com).
# Runs on a daemon thread inside this same process (see app.py) — no separate
# service to start. Register an app at https://auth.hackclub.com/developer/apps
# requesting only the `slack_id` scope.
# HCA_CLIENT_ID=YOUR_HCA_CLIENT_ID
# HCA_CLIENT_SECRET=YOUR_HCA_CLIENT_SECRET
# Must exactly match one of the redirect URIs registered with the HCA app.
# HCA_REDIRECT_URI=http://localhost:8000/oauth/callback
# HCA_REDIRECT_URI=https://coolton.tanjim.org/oauth/callback

# Signs the web UI's session cookie (HMAC-SHA256). Required for anyone to be
# able to sign in at all — with no key set, every session is rejected (fails
# closed, same posture as WEB_HELPER_TOKEN_FILE). Generate with e.g.
# `python3 -c "import secrets; print(secrets.token_hex(32))"`.
# COOLTON_WEB_SECRET=YOUR_RANDOM_SECRET

# Port the web UI listens on. Caddy/whatever reverse-proxies coolton.tanjim.org
# should point here.
# COOLTON_WEB_PORT=34343
