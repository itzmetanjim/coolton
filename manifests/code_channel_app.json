{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "coolton code channels",
    "description": "Creates Slack code channels for coolton.",
    "background_color": "#083927"
  },
  "features": {
    "bot_user": {
      "display_name": "coolton code channels",
      "always_online": false
    },
    "code_channels": {
      "enabled": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "code_channels:manage",
        "channels:write.invites",
        "groups:write.invites",
        "app_mentions:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "token_rotation_enabled": false
  }
}
